diff --git a/litedram/frontend/dma.py b/litedram/frontend/dma.py
index 3f31455..771f6f1 100644
--- a/litedram/frontend/dma.py
+++ b/litedram/frontend/dma.py
@@ -130,23 +130,36 @@ class LiteDRAMDMAReader(Module, AutoCSR):
 
         self.comb += self._offset.status.eq(offset)
 
+        # Latch `base` at each loop wrap instead of using it live, so that a
+        # `_base` write from software takes effect atomically on the next
+        # frame boundary rather than mid-transfer. Without this, in loop mode
+        # a mid-frame base change makes `sink.address` jump immediately
+        # (`base + offset`), which -- with a prefetch FIFO ahead of the
+        # consumer -- produces a mid-screen tear on every framebuffer flip and,
+        # over many flips, can wedge the FIFO/consumer entirely. As long as the
+        # FIFO holds less than one frame, latch-at-wrap makes the flip
+        # tear-free. (litex-pocket local change; upstream uses `base` live.)
+        base_latched = Signal(self.port.address_width, reset=default_base >> shift)
+
         fsm = FSM(reset_state="IDLE")
         fsm = ResetInserter()(fsm)
         self.submodules.fsm = fsm
         self.comb += fsm.reset.eq(~self._enable.storage)
         fsm.act("IDLE",
             NextValue(offset, 0),
+            NextValue(base_latched, base),
             NextState("RUN"),
         )
         fsm.act("RUN",
             self.sink.valid.eq(1),
             self.sink.last.eq(offset == (length - 1)),
-            self.sink.address.eq(base + offset),
+            self.sink.address.eq(base_latched + offset),
             If(self.sink.ready,
                 NextValue(offset, offset + 1),
                 If(self.sink.last,
                     If(self._loop.storage,
-                        NextValue(offset, 0)
+                        NextValue(offset, 0),
+                        NextValue(base_latched, base)
                     ).Else(
                         NextState("DONE")
                     )
