+# The name of the variable an object is assigned to is found by looking at
+# the bytecode that follows the call that created it. The dis module knows the
+# instruction layout of the running Python (inline caches, wordcode, the
+# renamed and fused opcodes of 3.11-3.14), so nothing here depends on it.
+
+_store_opcodes = ("STORE_NAME", "STORE_ATTR", "STORE_FAST", "STORE_DEREF")
+
+
+def _skippable(opc):
+    # what may sit between the call and the store: loading the target
+    # object (self.x = ...), duplicating the value (a = b = ...), ...
+    return (opc.startswith("LOAD_") or opc.startswith("BUILD_")
+            or opc in ("DUP_TOP", "COPY", "CACHE", "EXTENDED_ARG", "PUSH_NULL", "NOP"))
+
+
+_instructions_cache = {}
+
+
+def _instructions(code):
+    try:
+        return _instructions_cache[code]
+    except KeyError:
+        insns = list(dis.get_instructions(code))
+        by_offset = {i.offset: n for n, i in enumerate(insns)}
+        _instructions_cache[code] = (insns, by_offset)
+        return _instructions_cache[code]
 
 
