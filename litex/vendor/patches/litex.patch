index 20a4dc27..cf921450 100644
--- a/litex/soc/software/libbase/uart.c
+++ b/litex/soc/software/libbase/uart.c
@@ -12,6 +12,8 @@
 
 //#define UART_POLLING
 
+#define UART_TX_STALL_SPINS 4000000u   /* ~0.5 s: the JTAG relay moves ~24 bytes per round trip */
+
 #ifndef UART_POLLING
 
 #define UART_RINGBUFFER_SIZE_RX 128
@@ -84,7 +86,18 @@ void uart_write(char c)
 	unsigned int tx_produce_next = (tx_produce + 1) & UART_RINGBUFFER_MASK_TX;
 
 	if(irq_getie()) {
-		while(tx_produce_next == tx_consume);
+		/* Analogue Pocket: with the JTAG UART selected and no host reading
+		 * it, the ring never drains -- the BIOS hung in its banner before
+		 * DRAM init. Wait a bounded time for room, then drop output until
+		 * the ring drains again. */
+		static int tx_stalled;
+		if(tx_produce_next == tx_consume && !tx_stalled) {
+			for(unsigned int i = 0; i < UART_TX_STALL_SPINS && tx_produce_next == tx_consume; i++);
+			tx_stalled = tx_produce_next == tx_consume;
+		}
+		if(tx_produce_next == tx_consume)
+			return;
+		tx_stalled = 0;
 	} else if(tx_produce_next == tx_consume) {
 		return;
 	}
@@ -117,7 +130,8 @@ void uart_init(void)
 
 void uart_sync(void)
 {
-	while(tx_consume != tx_produce);
+	/* bounded, like uart_write(): nobody may be reading the JTAG UART */
+	for(unsigned int i = 0; i < UART_TX_STALL_SPINS && tx_consume != tx_produce; i++);
 }
 
 #else
@@ -142,7 +156,22 @@ int uart_read_nonblock(void)
 
 void uart_write(char c)
 {
-	while (uart_txfull_read());
+	/* Analogue Pocket: the UART is JTAG-only (analogue_pocket.py), and with
+	 * no host reading it txfull never clears -- the BIOS (UART_POLLING) hung
+	 * in its first printf and the Pocket failed the launch ("RS: Host
+	 * commands ignored", "RW: Target not responding"). Wait a bounded time,
+	 * then drop output until there is room again. */
+	static int tx_stalled;
+	if (uart_txfull_read()) {
+		if (tx_stalled)
+			return;
+		for (unsigned int i = 0; i < UART_TX_STALL_SPINS && uart_txfull_read(); i++);
+		if (uart_txfull_read()) {
+			tx_stalled = 1;
+			return;
+		}
+	}
+	tx_stalled = 0;
 	uart_rxtx_write(c);
 	uart_ev_pending_write(UART_EV_TX);
 }
@@ -155,7 +184,7 @@ void uart_init(void)
 
 void uart_sync(void)
 {
-	while (uart_txfull_read());
+	for (unsigned int i = 0; i < UART_TX_STALL_SPINS && uart_txfull_read(); i++);
 }
 
 #endif
