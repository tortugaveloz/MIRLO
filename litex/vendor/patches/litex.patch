+                    sys.exit(1)
+
+            current_address += len(frame_data)
+            position        += len(frame_data)
+
+        end = time.time()
+        print("|{}>| 100%".format("=" * 20))
+        print("[LITEX-TERM] Upload complete ({0:.1f}KB/s).".format(
+            length/((end - start)*1024 + 1e-9)))
         f.close()
