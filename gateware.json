{
    "name": "Mirlo",
    "displayName": "Mirlo",
    "description": "A RISC-V computer for the Analogue Pocket with MRDP, an N64-style rasterizer",
    "author": "tortuga",
    "version": "0.8.2",
    "license": "Apache-2.0",
    "repository": "https://github.com/tortugaveloz/MIRLO",
    "keywords": [
        "ecosystem:gateman"
    ],
    "scripts": {
        "verilator": "echo \"Error: no simulation specified\" && exit 1",
        "build:pocket": "quartus_sh --flow compile projects/openFPGA-RISC-V_pocket.qpf",
        "program:pocket": "quartus_pgm -m jtag -c 1 -o \"p;projects/output_files/openFPGA-RISC-V_pocket.sof@1\""
    },
    "platforms": {
        "pocket": "1.3.0"
    },
    "modules": {}
}
