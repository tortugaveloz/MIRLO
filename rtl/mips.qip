# MIRLO on MIPS (docs/mips.md): its own SoC, rtl/soc (no LiteX) -- the game
# CPU, the geom and audio cores (MIPS), MRDP, SDRAM, the scan-out. The Quartus
# project: projects_mips/ (MIRLO_MIPS). Before a compile: tools/mirlo_regs.py
# (the register map) and tools/mips_inits.py (the boot ROM and geom ROM
# images, after building lang/mips/boot and lang/c/geom with CPU=mips).
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/sdr_phy.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/sdr_ctrl.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/sdr_arb.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/afifo.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/fifo_fwft.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/n64_video.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/n64_bus.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/mirlo_regs.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/n64_ports.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/n64_geom.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/n64_uart.sv"]
set_global_assignment -name VERILOG_FILE         [file join $::quartus(qip_path) "soc/jtag_uart_bridge.v"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/mips_sys.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "soc/mirlo_mips.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "mips/fpu_n64.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "mips/mips_core.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "mips/mips_geom.sv"]
set_global_assignment -name QIP_FILE             [file join $::quartus(qip_path) "mrdp.qip"]
set_global_assignment -name VERILOG_FILE         [file join $::quartus(qip_path) "geom/GeomTcmRam.v"]
set_global_assignment -name QIP_FILE             [file join $::quartus(qip_path) "vpu/vpu.qip"]
set_global_assignment -name VERILOG_FILE         [file join $::quartus(qip_path) "audio/AudioCore.v"]
set_global_assignment -name VERILOG_FILE         [file join $::quartus(qip_path) "audio/AudioDspCfu.v"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "mips/mips_lite.sv"]
set_global_assignment -name SEARCH_PATH          [file join $::quartus(qip_path) "soc"]
set_global_assignment -name SYSTEMVERILOG_FILE   [file join $::quartus(qip_path) "video/rgb565_to_rgb888.sv"]
